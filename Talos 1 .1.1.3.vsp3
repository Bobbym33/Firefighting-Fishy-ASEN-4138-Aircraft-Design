      <CustomGeom>
        <Width Value="4.450000000000000178e+00" ID="TTWJLGHGEUQ"/>
        <Height Value="4.450000000000000178e+00" ID="WQMZDXMMJER"/>
        <Shape Value="0.000000000000000000e+00" ID="THZXJSSFMYQ"/>
        <Chord Value="3.000000000000000000e+00" ID="YXALSRKOWLS"/>
        <ThickChord Value="2.500000000000000000e-01" ID="ODHXMPDQVWP"/>
